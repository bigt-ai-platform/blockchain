<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>bigtangle</artifactId>
        <groupId>net.bigtangle</groupId>
        <version>0.6.0</version>
    </parent>
    <artifactId>l1-pai-mcmc</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>net.bigtangle</groupId>
            <artifactId>bigtangle-servercore</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.bigtangle</groupId>
            <artifactId>bigtangle-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.bigtangle</groupId>
            <artifactId>l1-pai-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${org.springframework.boot.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${org.springframework.boot.version}</version>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>exec</classifier>
                            <mainClass>net.bigtangle.l1.pai.PaiL1MCMCStart</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
