	<!-- Cross-layer primitives shared by Layer 0 and Layer 1: the anchor
	     checkpoint payload and (later) the bidirectional peg logic. Depends
	     only on bigtangle-core to stay dependency-light. See LAYERING-PLAN.md. -->
	<artifactId>bigtangle-bridge</artifactId>
	<packaging>jar</packaging>
	<dependencies>
		<dependency>
			<groupId>net.bigtangle</groupId>
			<artifactId>bigtangle-core</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
</project>
