{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "vmArgs": "--add-exports java.base/sun.nio.ch=ALL-UNNAMED -Xmx14g",
            "name": "layer0-server",
            "request": "launch",
            "mainClass": "net.bigtangle.layer0.server.Layer0ServerStart",
            "projectName": "layer0-server",
            "env": {
                "REQUESTER": "https://bigtangle.de:8088",
                "SERVER_NET": "Mainnet",
                "SERVER_PORT": "8081",
                "DB_NAME": "layer0",
                "SERVICE_MINING": "true"
            }
        },
        {
            "type": "java",
            "vmArgs": "--add-exports java.base/sun.nio.ch=ALL-UNNAMED -Xmx14g",
            "name": "layer1-server",
            "request": "launch",
            "mainClass": "net.bigtangle.l1.order.OrderMatchL1ServerStart",
            "projectName": "l1-order-server",
            "env": {
                "REQUESTER": "https://bigtangle.de:8088",
                "SERVER_NET": "Mainnet",
                "SERVER_PORT": "8083",
                "DB_NAME": "layer1",
                "LAYER1_CHAINID": "L1",
                "SERVICE_MINING": "true"
            }
        }
    ],
    "compounds": [
        {
            "name": "layer0-node",
            "configurations": ["layer0-server"]
        },
        {
            "name": "layer1-node",
            "configurations": ["layer1-server"]
        }
    ]
}
