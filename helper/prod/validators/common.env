# Shared production validator configuration.
# Sourced by every node-<i>/setup.sh. Override per node in node-<i>/validator.env.

# ---- Network / chain ------------------------------------------------------
SERVER_NET=Mainnet
SERVER_CHAIN=L0

# ---- PostgreSQL (one DB per node; DB_NAME is overridden per node) --------
DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=test1234
DBTYPE=postgresql

# ---- Executable (Docker images) ------------------------------------------
# SERVER_IMAGE / MCMC_IMAGE are the container images (built by helper/deploy.sh).
# DOCKER_NETWORK=host keeps the DB on localhost reachable and binds the node's
# ports directly on the host (no per-port -p mapping needed).
DOCKER_NETWORK=host
SERVER_IMAGE=ghcr.io/bigt-ai-platform/layer0-server
MCMC_IMAGE=ghcr.io/bigt-ai-platform/layer0-mcmc
IMAGE_TAG=latest
# Extra flags appended to every `docker run` (e.g. "-v /data/genesis:/genesis:ro").
DOCKER_RUN_FLAGS=

# ---- Java -----------------------------------------------------------------
# Passed to the container JVM (must include the add-exports used by the image).
JAVA_OPTS_SERVER="-Xmx5028m --add-exports java.base/sun.nio.ch=ALL-UNNAMED --add-exports java.base/java.lang=ALL-UNNAMED"
JAVA_OPTS_MCMC="-Xmx2048m --add-exports java.base/sun.nio.ch=ALL-UNNAMED --add-exports java.base/java.lang=ALL-UNNAMED"

# ---- PoS ------------------------------------------------------------------
POS_SLOT_INTERVAL_MS=12000
POS_SLOTS_PER_EPOCH=32

# ---- Stake (satoshis; 1 BIG = 10^6 satoshis) ------------------------------
# MIN_STAKE in code is 32,000,000 satoshis (= 32 BIG).
STAKE_AMOUNT=32000000
# Bootstrap funding per validator (only used when FUND_MODE=bootstrap).
FUND_AMOUNT=160000000

# ---- Bootstrap funding mode -----------------------------------------------
#   genesis   : validators are funded in the genesis distribution (Phase 3);
#               fundAddresses is NOT used.
#   bootstrap : validators are funded via the fundAddresses endpoint; the
#               server must be started with FUND_ENABLED=true (test/bootstrap
#               only — never on a public node).
# Fresh-chain prod test: no legacy snapshot exists, so validators are funded
# via fundAddresses (bootstrap), then staked+activated, then FUND_ENABLED is
# turned off before public exposure.
FUND_MODE=bootstrap
# Allows the fundAddresses endpoint (bootstrap funding). MUST be disabled
# before the node is publicly reachable.
FUND_ENABLED=true

# ---- Genesis distribution (migration) -------------------------------------
# Path to GenesisOutput.csv (produced by helper/prod/genesis.sh). When set,
# every node's genesis coinbase mints one output per CSV row (the legacy
# balances) instead of the single genesisPub output. Must be the SAME file on
# every node so all nodes derive the same genesis hash.
GENESIS_CSV=

# ---- Seeds / peers (host:port of the API servers) -------------------------
# REQUESTER for DAG sync; POS_GOSSIP_PEERS for the attestation mesh.
# Comma-separated host:port of every validator's server.
# Production test topology over the WireGuard mesh (10.8.0.x):
#   node-0 + node-1 -> s2001 (10.8.0.1), node-2 -> cui (10.8.0.2),
#   node-3 -> aliyun (10.8.0.3). Ports are per-node explicit in validator.env.
SEED_HOSTS="10.8.0.1:8081,10.8.0.1:8082,10.8.0.2:8083,10.8.0.3:8084"

# Gossip block mesh: <host>:<SERVER gossip port> in SEED_HOSTS order.
GOSSIP_SEEDS="10.8.0.1:9095,10.8.0.1:9099,10.8.0.2:9103,10.8.0.3:9107"
